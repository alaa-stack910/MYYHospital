@model MYYHospital.Models.Doctor

<h2>Edit Doctor</h2>


<form action="/Doctor/Edit" method="post">
    <input type="hidden" name="DoctorId" value="@Model.DoctorId" />
    <p>
        <label>Name</label>
        <input type="text" name="Name" value="@Model.Name" />
    </p>

    <p>
        <label>Specialty</label>
        <input type="text" name="Specialty" value="@Model.Specialty" />
    </p>

    <button type="submit">Save Changes</button>

</form>

    
<a href="/Doctor/Index">Back</a>


